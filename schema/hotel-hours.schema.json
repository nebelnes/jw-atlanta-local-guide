{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebelnes.github.io/jw-atlanta-local-guide/schema/hotel-hours.schema.json",
  "title": "Hotel outlet hours",
  "description": "Structure of data/hotel-hours.json. See docs/DATA_MODEL.md. Time order, unique ids and venue links are checked by scripts/lib/validate.mjs.",
  "type": "object",
  "required": ["timeZone", "verification", "outlets"],
  "additionalProperties": false,
  "properties": {
    "timeZone": { "type": "string", "enum": ["America/New_York"] },
    "verification": {
      "type": "object",
      "required": ["sourceLabel", "lastVerified"],
      "additionalProperties": false,
      "properties": {
        "sourceLabel": { "type": "string", "minLength": 1 },
        "lastVerified": { "type": "string", "format": "date" }
      }
    },
    "outlets": { "type": "array", "items": { "$ref": "#/$defs/outlet" } }
  },
  "$defs": {
    "time": {
      "description": "24-hour HH:MM in the hotel's time zone. A close of 24:00 means midnight at the end of that day.",
      "type": "string",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
    },
    "outlet": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1, "description": "Where in the hotel, e.g. \"Lobby Level\"." },
        "description": { "type": "string", "minLength": 1 },
        "venueId": { "type": "string", "description": "The matching venue in data/venues.json, if any; its card then shows these hours." },
        "open24h": { "type": "boolean" },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["days", "open", "close"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "description": "e.g. \"Breakfast\"" },
              "days": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
              },
              "open": { "$ref": "#/$defs/time" },
              "close": { "$ref": "#/$defs/time" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
