{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebelnes.github.io/jw-atlanta-local-guide/schema/route.schema.json",
  "title": "Walking route from the hotel to one venue (data/routes/<venue-id>.json)",
  "description": "Generated by scripts/build-walking-routes.mjs from OpenStreetMap data. Cross-file rules are enforced by scripts/validate-data.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["venueId", "sameBuilding", "distanceMeters", "durationMinutes", "geometry", "steps", "landmarks", "from", "to", "source", "computedAt", "reviewed"],
  "properties": {
    "venueId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sameBuilding": { "description": "True when the venue is inside the hotel; no route is drawn.", "type": "boolean" },
    "distanceMeters": { "type": "integer", "minimum": 0 },
    "durationMinutes": { "type": "integer", "minimum": 0 },
    "geometry": {
      "description": "Route path as [lng, lat] pairs, starting at the hotel.",
      "type": "array",
      "items": { "type": "array", "items": { "type": "number" } }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instruction", "distanceMeters", "startMeters", "passing"],
        "properties": {
          "instruction": { "type": "string", "minLength": 1 },
          "distanceMeters": { "type": "integer", "minimum": 0 },
          "startMeters": { "type": "integer", "minimum": 0 },
          "passing": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["landmarkId", "side"],
              "properties": {
                "landmarkId": { "type": "string", "minLength": 1 },
                "side": { "enum": ["left", "right"] }
              }
            }
          }
        }
      }
    },
    "landmarks": {
      "description": "Landmarks the route passes within 40 m of, in walking order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["landmarkId", "side", "atMeters", "metersFromRoute"],
        "properties": {
          "landmarkId": { "type": "string", "minLength": 1 },
          "side": { "enum": ["left", "right"] },
          "atMeters": { "type": "integer", "minimum": 0 },
          "metersFromRoute": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "from": { "type": "string", "minLength": 1 },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "source": { "type": "string", "minLength": 1 },
    "computedAt": { "type": "string", "format": "date" },
    "reviewed": { "description": "Set to true once someone who knows the walk has checked the steps.", "type": "boolean" }
  }
}
